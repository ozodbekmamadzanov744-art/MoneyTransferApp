<#import "layout.ftlh" as l><@l.page 'nav.payment'><h1><@l.msg 'nav.payment'/></h1><section class="narrow"><#if accounts?has_content>
<form method="post" action="/payment" class="stack"><@l.csrf/><@l.source accounts=accounts selected=(paymentDto.sourceId!0)/><@l.fieldErrors "paymentDto.sourceId"/><label><@l.msg 'field.provider'/><select name="providerId" required><#list providers as provider><option value="${provider.id}" <#if (paymentDto.providerId!0) == provider.id>selected</#if>>${provider.name} · ${provider.currency}</option></#list></select></label><@l.fieldErrors "paymentDto.providerId"/><@l.field "paymentDto.reference" "field.reference"/><@l.field "paymentDto.amount" "field.amount"/><p class="muted"><@l.msg 'amount.help'/></p><button><@l.msg 'action.pay'/></button></form><p class="muted"><@l.msg 'moderation.help'/></p><#else><p><@l.msg 'accounts.empty'/></p><a href="/"><@l.msg 'accounts.create'/></a></#if></section></@l.page>
